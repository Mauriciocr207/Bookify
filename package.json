{
  "name": "bookify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-assets": "cp ./node_modules/pdfjs-dist/build/pdf.worker.min.mjs ./public/",
    "dev": "npm run copy-assets && next dev --turbopack",
    "build": "npm run copy-assets && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:pull": "npx prisma db pull --schema ./src/server/prisma/schema.prisma",
    "prisma:generate": "npx prisma generate --schema ./src/server/prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema ./src/server/prisma/schema.prisma",
    "prisma:seed": "npx prisma db seed --schema ./src/server/prisma/schema.prisma",
    "postinstall": "npm run prisma:generate"
  },
  "prisma": {
    "seed": "tsx ./src/server/prisma/seeders/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.837.0",
    "@aws-sdk/s3-request-presigner": "^3.837.0",
    "@heroui/react": "^2.6.13",
    "@hookform/resolvers": "^5.1.1",
    "@prisma/client": "^6.11.0",
    "@react-types/shared": "^3.27.0",
    "@supabase/supabase-js": "^2.50.3",
    "@tanstack/react-query": "^5.81.5",
    "axios": "^1.10.0",
    "dexie": "^4.0.11",
    "dotenv": "^17.0.1",
    "framer-motion": "^11.16.4",
    "next": "15.1.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.59.0",
    "react-icons": "^5.5.0",
    "slugify": "^1.6.6",
    "zod": "^3.25.71"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.3.1",
    "@types/node": "^24.0.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.3",
    "postcss": "^8",
    "prisma": "^6.11.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "wrangler": "^4.21.2"
  }
}
