{
  "ts-node": {
    "esm": true
  },
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "src",
    "paths": {
      "@components/*": ["components/*"],
      "@context": ["context/index.ts"],
      "@hooks": ["hooks/index.ts"],
      "@app-types/*": ["types/*"],
      "@models": ["models/index.ts"],
      "@providers": ["providers/index.tsx"],
      "@styles": ["styles/index.css"],
      "@server/*": ["server/*"],
      "@utils": ["utils/index.ts"],
      "@config": ["config.ts"],
      "@validation/*": ["validation/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "prisma.config.ts"
  ],
  "exclude": ["node_modules"]
}
